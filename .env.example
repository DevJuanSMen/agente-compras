# ================= IA (al menos una clave) =================
# Orden de preferencia: AGENTE_PROVEEDOR primero y, si falla o se agota el cupo,
# el agente pasa solo al siguiente proveedor con clave.
AGENTE_PROVEEDOR=gemini
GEMINI_API_KEY=            # aistudio.google.com/apikey
# AGENTE_GEMINI_MODELO=gemini-flash-lite-latest   (alias: no se rompe cuando retiran versiones)
GROQ_API_KEY=              # console.groq.com/keys
NVIDIA_API_KEY=            # build.nvidia.com

# ================= Fuentes de precios =================
AGENTE_BUSCADOR=ddg        # ddg (sin key) | tavily
# TAVILY_API_KEY=
# MercadoLibre bloquea el acceso automatico. Con un token de su API oficial
# (developers.mercadolibre.com.co) sus precios pasan a ser verificables.
# ML_ACCESS_TOKEN=

# ================= Servidor =================
# COMPRAS_DATABASE_URL=postgresql+psycopg://usuario:clave@host/compras   (por defecto SQLite en backend/datos)
# COMPRAS_CLAVE_INICIAL=Uparsistem2026*    clave de usuarios nuevos (se cambia en el primer ingreso)
# COMPRAS_URL_PUBLICA=http://compras.uparsistem.edu.co   para los enlaces de los correos
# COMPRAS_JWT_HORAS=12

# ================= Correo (opcional) =================
# Sin SMTP_HOST las notificaciones quedan solo dentro de la aplicacion.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=compras@uparsistem.edu.co
# SMTP_CLAVE=
# SMTP_REMITENTE=compras@uparsistem.edu.co
